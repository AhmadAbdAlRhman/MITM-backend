NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# Comma-separated list of allowed CORS origins.
# CORS is a browser-side control. It does NOT restrict server-to-server calls
# or tools like curl, Postman, or mitmproxy. Use firewall/network rules for that.
CORS_ORIGINS=http://localhost:5173,http://192.168.56.30:5173

LOG_LEVEL=info

# Rate limiting window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100
